.{
    .name = .zaxonlite,
    .version = "0.1.2",
    .fingerprint = 0xdf9f861eecc5d6a3, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .paxos = .{ .path = ".." },
        .sqlite = .{
            .url = "https://sqlite.org/2025/sqlite-amalgamation-3500400.zip",
            .hash = "N-V-__8AAHCbqABM_X5RTjbDBDBWErxZE8tJzmtEnLOLRHGx",
        },
        .vaxis = .{
            .url = "git+https://github.com/rockorager/libvaxis?ref=main#d63a23c593c9b82f0b2886840161fa1f1df983e9",
            .hash = "vaxis-0.6.0-BWNV_DsLCgCcKudOoFkyrSgjxUeLAOSf1LxwezEeVieH",
        },
    },
    // `include` ships the C ABI header that build.zig installs, and `test`
    // ships the C smoke test it compiles; both must travel with the package
    // or dependency builds cannot construct the build graph.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "include",
        "test",
        "README.md",
        "LICENSE",
    },
}
